# Copy to /mnt/tank/teem/config/teem.env and replace every example value.
# These names are consumed by the Compose shell command, not by Teem itself.
# Match the password in config/postgres_password; URL-encode special DSN characters.
TEEM_DSN=postgresql://teem:replace-with-encoded-postgres-password@postgres:5432/teem
TEEM_USER=operator
TEEM_PASSWORD=replace-with-long-random-browser-password
TEEM_WORKER_TOKEN=replace-with-long-random-worker-token
TEEM_ORIGIN=https://teem.example.com
TEEM_VAPID_SUBJECT=mailto:operator@example.com
